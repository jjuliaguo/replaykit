{
  "name": "replaykit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReplayKit: turn failed voice-agent calls into reproducible regression tests.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "schema": "tsx scripts/generate-schemas.ts",
    "extract": "tsx src/extractor/cli.ts",
    "fixtures": "tsx src/extractor/cli.ts examples/call-logs --out fixtures/generated --extracted-at 2026-10-15T00:00:00.000Z",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "openai": "^7.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "exports": {
    "./shared": "./src/shared/types.ts"
  }
}
