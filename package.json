{
  "name": "replaykit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replay failed AI-agent interactions as reproducible regression tests.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/replay/cli.ts demo",
    "replay": "tsx src/replay/cli.ts replay",
    "compare": "tsx src/replay/cli.ts compare",
    "server": "tsx src/replay/cli.ts server",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
