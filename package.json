{
  "name": "replaykit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReplayKit: turn failed voice-agent calls into reproducible regression tests. Integrated build: Claude's extractor + Cursor's replay engine + local web app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web": "tsx src/web/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "extract": "tsx src/extractor/cli.ts",
    "fixtures": "tsx src/extractor/cli.ts examples/call-logs --out fixtures/generated --extracted-at 2026-10-15T00:00:00.000Z",
    "schema": "tsx scripts/generate-schemas.ts",
    "demo": "tsx src/replay/cli.ts demo",
    "replay": "tsx src/replay/cli.ts replay",
    "compare": "tsx src/replay/cli.ts compare",
    "server": "tsx src/replay/cli.ts server"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "exports": {
    "./shared": "./src/shared/types.ts"
  }
}
